VITE_TMDB_READ_API_KEY=...
VITE_OPENSEARCH_ENABLED=false

# make sure the cors proxy url does NOT have a slash at the end
VITE_CORS_PROXY_URL=...

# likewise
VITE_M3U8_PROXY_URL=...

# Optional authorized source resolvers used by the local provider adapter.
# Each endpoint receives POST { "media": { ... } } by default, or media fields
# as query parameters when method is GET. The endpoint should return either:
# { "type": "hls", "playlist": "https://...", "captions": [] }
# or { "type": "file", "qualities": { "1080": { "url": "https://..." } }, "captions": [] }
VITE_AUTHORIZED_PROVIDER_CONFIG='[{"id":"synapse","name":"Synapse Source","endpoint":"https://your-authorized-resolver.example/resolve","method":"POST"}]'

# make sure the domain does NOT have a slash at the end
VITE_APP_DOMAIN=http://localhost:5173

# Backend URL(s) - can be a single URL or comma-separated list (e.g., "https://server1.com,https://server2.com,https://server3.com")
VITE_BACKEND_URL=https://server1.com,https://server2.com,https://server3.com

# Trakt integration setup. Get these at https://trakt.tv/oauth/applications
VITE_TRAKT_CLIENT_ID=
VITE_TRAKT_CLIENT_SECRET=
TRAKT_REDIRECT_URI=https://your domain
